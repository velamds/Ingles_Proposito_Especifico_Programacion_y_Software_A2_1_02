ct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: Move the words from the box to correctly complete the sentences.<br>\nYou have 2 attempts to submit your answers.", "type": "text"}], "type": "post_instructions"}], "id": 2, "type": "SFL"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Activity 2", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 3, "type": "EXT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Activity 3", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 4, "type": "EXT1"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 0}, {"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "My paragraph", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 1}], "template_override": 1, "stimuli_ids": [2], "_data": [{"contents": [{"content": "<b>Let's write about what we learnt about DSS.</b></br></br><span class=\"italic\"> <li>Write a paragraph (100-120 words) on the subject of Decision Support Systems.<br>\n<li>Think of a topic sentence that expresses your opinion about the importance of DSS in a company.\n<li>Provide arguments for your opinion using body sentences.<br>\n<li>Summarize your ideas in a simple concluding sentence.<br><br><br>\n\n\nWhen you have typed in ALL your answers, click on the <span class=\"strong\">Go to Writing Task</span> button.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 3", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "<span class=\"italic\"> It's time to review your work.<br><br>\n\nRemember that your text must include:<br>\n<li>Modal verbs (can, could, should, have to,